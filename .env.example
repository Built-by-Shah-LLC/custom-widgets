# Supabase (existing)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google Maps business search
GOOGLE_PLACES_API_KEY=

# Critical alerts (Resend) — ALERT_EMAILS is comma-separated and can change anytime
RESEND_API_KEY=
ALERT_FROM=alerts@your-verified-domain.com
ALERT_EMAILS=ali@builtbyshah.com,aliamin588@gmail.com

# Required for local Next.js + Playwright (service role bypasses RLS server-side)
SUPABASE_SERVICE_ROLE_KEY=

# Local embed E2E harness (Playwright sets these automatically via webServer)
# ENABLE_E2E_HARNESS=true
# ALLOW_LOCALHOST_EMBEDS=true

# Playwright
E2E_BASE_URL=http://127.0.0.1:3000
E2E_CANARY_URL=https://embed-site-seven.vercel.app
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# E2E_SKIP_WEBSERVER=1

# Vercel Cron bearer secret for /api/cron/review-sync (weekly review refresh).
# Vercel auto-sends "Authorization: Bearer $CRON_SECRET" on cron requests.
CRON_SECRET=
# Optional: reviews fetched per business during the cron refresh (default 40)
CRON_SYNC_MAX_REVIEWS=40
