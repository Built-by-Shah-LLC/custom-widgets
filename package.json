{
  "name": "custom-widgets-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run watch:widget\" \"next dev\"",
    "build": "npm run build:widget && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "watch:widget": "node scripts/build-widget.mjs --watch",
    "migrate": "node scripts/apply-migration.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=local",
    "test:e2e:loader": "npm run build:widget && playwright test --project=loader",
    "test:e2e:mutations": "E2E_RUN_MUTATIONS=true playwright test --project=mutation",
    "test:e2e:canary": "E2E_SKIP_WEBSERVER=1 playwright test --project=canary",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:canary"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/functions": "^3.9.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "preact": "^10.29.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
